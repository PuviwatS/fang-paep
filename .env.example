# Copy to .env.local for your own Supabase project. Values in .env.local override .env.

# Public (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — only for scripts/refresh-previews.ts on your own machine.
# Never commit it, never prefix it with NEXT_PUBLIC_, never paste it into chat.
SUPABASE_SECRET_KEY=sb_secret_...
