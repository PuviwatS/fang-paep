PORT=4000
DATABASE_URL=postgres://postgres:replace-me@127.0.0.1:5432/fangpap
FRONTEND_URL=http://localhost:3000
# Generate separate random secrets of at least 32 characters. Do not reuse these placeholders.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=fang-paep-api
JWT_AUDIENCE=fang-paep-web
# Use production only behind HTTPS; cookies become Secure.
NODE_ENV=development
# Required in production: explicit last-proxy IPs/CIDRs, NEVER a trust-all range.
# The trusted public edge must overwrite X-Forwarded-For; keep Next/API private.
# Example for a local last proxy: 127.0.0.1/32,::1/128
TRUST_PROXY_CIDRS=
# Resend (preferred when configured); keep this key server-side. SMTP is the fallback.
RESEND_API_KEY=
MAIL_FROM=Fang Paep <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Port 587 requires STARTTLS; port 465 uses SMTP_SECURE=true. Plaintext SMTP is unsupported.
SMTP_USER=
SMTP_PASSWORD=
# Optional for integration tests; use a disposable database, never your application database.
TEST_DATABASE_URL=
