{
  "name": "@fang-paep/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src scripts tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "refresh-previews": "tsx scripts/refresh-previews.ts",
    "generate-seed": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.5.0",
    "pg": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.14.10",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "8.57.1",
    "supertest": "7.3.2",
    "tsx": "4.19.2",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
